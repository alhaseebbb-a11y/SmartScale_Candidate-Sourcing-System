# ==========================================
# SMARTSKALE BACKEND ENVIRONMENT TEMPLATE
# ==========================================

# Environment & Server
ENV=production
APP_NAME="SmartSkale Candidate Sourcing System"
APP_VERSION=1.0.0

# ------------------------------------------
# 1. AWS RDS PostgreSQL Database
# ------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<rds-endpoint>:5432/<dbname>
# Note: You can paste postgresql:// or postgres:// directly; the app auto-normalizes it.
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@your-rds-endpoint.rds.amazonaws.com:5432/smartskale

# ------------------------------------------
# 2. Authentication & Security
# ------------------------------------------
JWT_SECRET_KEY=generate-a-strong-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# Initial Admin Seeding (runs automatically on deploy)
SEED_ADMIN_EMAIL=hasibshaikh583@gmail.com
SEED_ADMIN_PASSWORD=Admin@12345

# ------------------------------------------
# 3. AWS S3 File Storage (Resumes)
# ------------------------------------------
# Set STORAGE_BACKEND=s3 for AWS S3, or STORAGE_BACKEND=local for local development
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-smartskale-resumes-bucket

# Local storage fallback
UPLOAD_DIR=./uploads
MAX_RESUME_SIZE_MB=5
MAX_PHOTO_SIZE_MB=2

# ------------------------------------------
# 4. Gmail SMTP Email Notifications
# ------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hasibshaikh583@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=hasibshaikh583@gmail.com
SMTP_USE_TLS=true
NOTIFY_CANDIDATE_EMAIL_ON_STATUS_CHANGE=true

# ------------------------------------------
# 5. Frontend URLs & CORS
# ------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173
